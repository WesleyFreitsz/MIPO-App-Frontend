{
  "expo": {
    "name": "MipoSocial",
    "slug": "board-game-hub-mobile",
    "scheme": "mipo",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6E22D"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wesleyfreitsz.boardgamehubmobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-video",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6E22D"
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#F6E22D"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A Mipo usa a câmera para ler o QR code de check-in da loja.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "10b3131c-b09c-48e2-b9da-a35dd76e0ab3"
      }
    }
  }
}
